<Window x:Class="Kirin_Tool.MainWindow"
                 xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 Title="Kirin-Tool v2.4.2" Height="700" Width="1000"
                 WindowStartupLocation="CenterScreen">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Kirin-Tool v2.4.2" Margin="16,8" FontSize="18" FontWeight="Bold"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SystemRegionBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="16">
                            <TextBlock Text="CPU Model" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ComboBox x:Name="CpuComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="Select CPU Model..." IsEnabled="False"/>
                                <ComboBoxItem Content="Kirin 65x_a (hisi65x_a)"/>
                                <ComboBoxItem Content="Kirin 65x_b (hisi65x_b)"/>
                                <ComboBoxItem Content="Kirin 620 (hisi620)"/>
                                <ComboBoxItem Content="Kirin 620c (hisi620c)"/>
                                <ComboBoxItem Content="Kirin 925 (hisi925)"/>
                                <ComboBoxItem Content="Kirin 935 (hisi935)"/>
                                <ComboBoxItem Content="Kirin 950 (hisi950)"/>
                                <ComboBoxItem Content="Kirin 955 (hisi955)"/>
                                <ComboBoxItem Content="Kirin 960 (hisi960)"/>
                                <ComboBoxItem Content="Kirin 970 (hisi970)"/>
                                <ComboBoxItem Content="Kirin 980 (hisi980)"/>
                                <ComboBoxItem Content="Kirin 985 (hisi985)"/>
                                <ComboBoxItem Content="Kirin 990 5G (hisi990)"/>
                                <ComboBoxItem Content="Kirin 710 (hisi710)"/>
                                <ComboBoxItem Content="Kirin 710a (hisi710a)"/>
                                <ComboBoxItem Content="Kirin 810 (hisi810)"/>
                                <ComboBoxItem Content="Kirin 820 (hisi820)"/>
                                <ComboBoxItem Content="Kirin K3v2 (hisik3v2)"/>
                            </ComboBox>
                        </StackPanel>

                        <ListBox x:Name="NavigationListBox"
                              Grid.Row="1"
                              Width="320"
                              Margin="0,8,0,0">

                                <ListBoxItem Content="Welcome"
                                      x:Name="WelcomeItem"/>
                                <ListBoxItem Content="Device Information"
                                      x:Name="DeviceInfoItem"/>
                                <ListBoxItem Content="VCOM Operations"
                                      x:Name="VcomItem"/>
                                <ListBoxItem Content="Flash Operations"
                                      x:Name="FlashItem"/>
                                <ListBoxItem Content="Security Tools"
                                      x:Name="SecurityItem"/>
                                <ListBoxItem Content="OEMInfo Tools"
                                      x:Name="OEMInfoItem"/>
                                <ListBoxItem Content="NVMe Tools"
                                      x:Name="NVMeItem"/>
                                <ListBoxItem Content="About"
                                                  x:Name="AboutItem"/>
                        </ListBox>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1" 
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">

                    <Grid x:Name="ContentContainer">

                        <StackPanel x:Name="WelcomePage" Margin="40,32,40,32">
                            <TextBlock Text="Welcome to Kirin-Tool" 
                                  FontSize="32" 
                                  FontWeight="Light"
                                  Margin="0,0,0,16"/>

                            <TextBlock Text="The best free tool to deal with HiSilicon Kirin devices"
                                  FontSize="16"
                                  Opacity="0.7"
                                  Margin="0,0,0,32"/>

                            <Expander Header="Quick Start Guide"
                                        
                                        Margin="0,0,0,16"
                                        IsExpanded="True">
                                <StackPanel>
                                    <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,8" Margin="0,0,0,4">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Step 1: Select CPU Model" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Choose your device's CPU model from the dropdown above" 
                                              FontSize="12" 
                                              Opacity="0.7"/>
                    </StackPanel>
                </Border>
                                    <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,8" Margin="0,0,0,4">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Step 2: Connect Device" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock 
                                              FontSize="12" 
                                              Opacity="0.7">
                                    Connect your device in VCOM (USB COM 1.0) mode <LineBreak /> Make sure that the drivers are installed ;)
                                        </TextBlock>
                    </StackPanel>
                </Border>
                                    <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,8" Margin="0,0,0,4">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Step 3: Choose Operation" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Navigate to the appropriate section for your desired operation" 
                                              FontSize="12" 
                                              Opacity="0.7"/>
                    </StackPanel>
                </Border>
                                </StackPanel>
                            </Expander>

                            <Border Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16"><StackPanel><TextBlock Text="Important Notice" FontWeight="SemiBold" Foreground="Black"/><TextBlock Text="We are not responsible for any kind of damage you do with this tool. Use it at your own risk." TextWrapping="Wrap" Foreground="Black"/></StackPanel></Border>

                            <Border Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16"><StackPanel><TextBlock Text="Beware!" FontWeight="SemiBold" Foreground="Black"/><TextBlock Text="Kirin-Tool is free software. If you have paid for this tool, you have been scammed - please ask for a refund immediately!" TextWrapping="Wrap" Foreground="Black"/></StackPanel></Border>

                        </StackPanel>

                        <StackPanel x:Name="DeviceInfoPage" Margin="40,32,40,32" IsVisible="False">
                            <TextBlock Text="Device Information" 
                                   FontSize="28" 
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                            <TextBlock Text="Connected Device Details"
                                   FontSize="14"
                                   Opacity="0.7"
                                   Margin="0,0,0,32"/>

                            <Expander x:Name="DeviceInfoExpander"
                                         Header="Information"
                                         
                                         Margin="0,0,0,4"
                                         IsExpanded="False">
                                <StackPanel>
                                    <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,8" Margin="0,0,0,4">
                    <StackPanel Spacing="4">
                        <TextBlock Text="FB Lock" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="InfoFbLock" 
                                                 Text="Not Read"
                                                 FontWeight="SemiBold"
                                                 Opacity="0.7"/>
                    </StackPanel>
                </Border>

                                    <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,8" Margin="0,0,0,4">
                    <StackPanel Spacing="4">
                        <TextBlock Text="User Lock" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="InfoUserLock" 
                                                 Text="Not Read"
                                                 FontWeight="SemiBold"
                                                 Opacity="0.7"/>
                    </StackPanel>
                </Border>

                                    <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,8" Margin="0,0,0,4">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Device Model" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="InfoDeviceModel" 
                                                 Text="Not Read"
                                                 FontWeight="SemiBold"
                                                 Opacity="0.7"/>
                    </StackPanel>
                </Border>
                                    
                                    <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,8" Margin="0,0,0,4">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Vendor / Country" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="InfoVendorCountry" 
                                                 Text="Not Read"
                                                 FontWeight="SemiBold"
                                                 Opacity="0.7"/>
                    </StackPanel>
                </Border>

                                    <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,8" Margin="0,0,0,4">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Build Number" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="InfoBuildNumber" 
                                                 Text="Not Read"
                                                 FontWeight="SemiBold"
                                                 Opacity="0.7"/>
                    </StackPanel>
                </Border>

                                    <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,8" Margin="0,0,0,4">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Base Version" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="InfoBaseVersion" 
                                                 Text="Not Read"
                                                 FontWeight="SemiBold"
                                                 Opacity="0.7"/>
                    </StackPanel>
                </Border>

                                    <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,8" Margin="0,0,0,4">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Custom Version" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="InfoCustomVersion" 
                                                 Text="Not Read"
                                                 FontWeight="SemiBold"
                                                 Opacity="0.7"/>
                    </StackPanel>
                </Border>

                                    <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,8" Margin="0,0,0,4">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Preload Version" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="InfoPreloadVersion" 
                                                 Text="Not Read"
                                                 FontWeight="SemiBold"
                                                 Opacity="0.7"/>
                    </StackPanel>
                </Border>
                                </StackPanel>
                            </Expander>

                            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                <Button Content="Read Info"
                                           
                                           Width="140"
                                           Height="40"
                                           Margin="0,0,16,0"
                                           Click="ReadDeviceInfo_Click"/>
                                
                                <Button Content="Reboot"
                                           
                                           Width="140"
                                           Height="40"
                                           Click="RebootDevice_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="VcomPage" Margin="40,32,40,32" IsVisible="False">
                            <TextBlock Text="VCOM Operations" 
                                  FontSize="28" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,8"/>

                            <TextBlock Text="Boot into an unlocked fastboot state from VCOM (USB COM 1.0) mode"
                                  FontSize="14"
                                  Opacity="0.7"
                                  Margin="0,0,0,32"/>

                            <Expander Header="Device Operations"
                                        
                                        Margin="0,0,0,4"
                                        IsExpanded="True">
                                <StackPanel>
                                    <Grid Margin="0,8,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Unlock Fastboot"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Margin="0,0,0,4"/>
                                            <TextBlock Text="Put device into unlocked fastboot state"
                                                   FontSize="12"
                                                   Opacity="0.7"/>
                                            <ToggleSwitch x:Name="UseFastFlashLoaderSwitch"
                                                   Content="Use FastFlash loader"
                                                   IsVisible="False"
                                                   Margin="0,16,0,0" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                               Content="Unlock"
                                               Width="100"
                                               Height="40"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Tag="unlock-fastboot"
                                               Click="OperationButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Software Testpoint"
                                         
                                         Margin="0,0,0,16"
                                         IsExpanded="False">
                                <StackPanel>
                                    <TextBlock Text="Put your device into VCOM mode without disassembling it"
                                           FontSize="12"
                                           Opacity="0.7"
                                           Margin="0,0,0,16"/>

                                    <Border Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16"><StackPanel><TextBlock Text="Important notice" FontWeight="SemiBold" Foreground="Black"/><TextBlock Text="This feature only works on softwares before the 2021 February security patch (EMUI 10 and older), if you are running a newer system, please downgrade to use this feature. &#10;&#10;For the UPDATE file use a Base UPDATE.APP from the exact or newer firmware your device is currently running." TextWrapping="Wrap" Foreground="Black"/></StackPanel></Border>

                                    <Grid Margin="0,8,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" 
                                                 Watermark="Base UPDATE.APP"
                                                 Text="{Binding SwTpUpdateFile.FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="True"
                                                 Margin="0,0,8,0"/>
                                        <Button Grid.Column="1"
                                               Content="Browse"
                                               
                                               Tag="SwTpUpdate"
                                               Click="BrowseOtaFile_Click"
                                               Margin="0,0,4,0"/>
                                        <Button Grid.Column="2" 
                                               Content="Clear" 
                                               
                                               Tag="SwTpUpdate"
                                               Click="ClearOtaFile_Click" 
                                               IsEnabled="{Binding SwTpUpdateFile.HasFile, Mode=OneWay}"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Enter"
                                               Width="100"
                                               Height="40"
                                               Margin="0,0,8,0"
                                               Tag="sw-testpoint-enter"
                                               Click="OperationButton_Click"/>
                                        <Button Content="Exit"
                                               Width="100"
                                               Height="40"
                                               Tag="sw-testpoint-exit"
                                               Click="OperationButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <StackPanel x:Name="FlashPage" Margin="40,32,40,32" IsVisible="False">
                            <TextBlock Text="Flash Operations" 
                                  FontSize="28" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,8"/>

                            <TextBlock Text="Flash firmware and system images"
                                  FontSize="14"
                                  Opacity="0.7"
                                  Margin="0,0,0,32"/>

                            <Expander Header="Full OTA Flash"
                                         
                                         Margin="0,0,0,16"
                                         IsExpanded="True">
                                <StackPanel>
                                    <TextBlock Text="Do a complete flash of your device"
                                       FontSize="12"
                                       Opacity="0.7"
                                       Margin="0,0,0,16"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <RadioButton Content="Fastboot Mode" 
                                                   IsChecked="{Binding IsFastbootUpdateSelected, Mode=TwoWay}"
                                                   Margin="0,0,24,0"/>
                                        <RadioButton Content="USB Update Mode" 
                                                   IsChecked="{Binding IsUsbUpdateSelected, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                            Text="Base PTABLE" 
                                            FontWeight="SemiBold" 
                                            FontSize="12"
                                            VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1" 
                                            x:Name="BasePtablePathText"
                                            Text="{Binding BasePtableFile.FileName, Mode=OneWay}" 
                                            IsReadOnly="True"
                                            Watermark="No file selected"
                                            Margin="8,0"/>

                                        <Button Grid.Column="2" 
                                            Content="Browse" 
                                            
                                            Tag="BasePtable"
                                            Click="BrowseOtaFile_Click" 
                                            Margin="0,0,4,0"/>

                                        <Button Grid.Column="3" 
                                            Content="Edit" 
                                            
                                            Tag="BasePtable"
                                            Click="EditOtaFile_Click" 
                                            IsEnabled="{Binding BasePtableFile.IsEditEnabled, Mode=OneWay}"
                                            Margin="0,0,4,0"/>

                                        <Button Grid.Column="4" 
                                            Content="Clear" 
                                            
                                            Tag="BasePtable"
                                            Click="ClearOtaFile_Click" 
                                            IsEnabled="{Binding BasePtableFile.HasFile, Mode=OneWay}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                           Text="Base UPDATE" 
                                           FontWeight="SemiBold" 
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1" 
                                            x:Name="BaseUpdatePathText"
                                            Text="{Binding BaseUpdateFile.FileName, Mode=OneWay}" 
                                            IsReadOnly="True"
                                            Watermark="No file selected"
                                            Margin="8,0"/>

                                        <Button Grid.Column="2" 
                                           Content="Browse" 
                                           
                                           Tag="BaseUpdate"
                                           Click="BrowseOtaFile_Click" 
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="3" 
                                           Content="Edit" 
                                           
                                           Tag="BaseUpdate"
                                           Click="EditOtaFile_Click" 
                                           IsEnabled="{Binding BaseUpdateFile.IsEditEnabled, Mode=OneWay}"
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="4" 
                                           Content="Clear" 
                                           
                                           Tag="BaseUpdate"
                                           Click="ClearOtaFile_Click" 
                                           IsEnabled="{Binding BaseUpdateFile.HasFile, Mode=OneWay}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8" IsVisible="{Binding IsUsbUpdateSelected}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                           Text="Cust PTABLE" 
                                           FontWeight="SemiBold" 
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1" 
                                            x:Name="CustPtablePathText"
                                            Text="{Binding CustPtableFile.FileName, Mode=OneWay}" 
                                            IsReadOnly="True"
                                            Watermark="No file selected"
                                            Margin="8,0"/>

                                        <Button Grid.Column="2" 
                                           Content="Browse" 
                                           
                                           Tag="CustPtable"
                                           Click="BrowseOtaFile_Click" 
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="3" 
                                           Content="Edit" 
                                           
                                           Tag="CustPtable"
                                           Click="EditOtaFile_Click" 
                                           IsEnabled="False"
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="4" 
                                           Content="Clear" 
                                           
                                           Tag="CustPtable"
                                           Click="ClearOtaFile_Click" 
                                           IsEnabled="{Binding CustPtableFile.HasFile, Mode=OneWay}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                           Text="Cust UPDATE" 
                                           FontWeight="SemiBold" 
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1" 
                                            x:Name="CustUpdatePathText"
                                            Text="{Binding CustUpdateFile.FileName, Mode=OneWay}" 
                                            IsReadOnly="True"
                                            Watermark="No file selected"
                                            Margin="8,0"/>

                                        <Button Grid.Column="2" 
                                           Content="Browse" 
                                           
                                           Tag="CustUpdate"
                                           Click="BrowseOtaFile_Click" 
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="3" 
                                           Content="Edit" 
                                           
                                           Tag="CustUpdate"
                                           Click="EditOtaFile_Click" 
                                           IsEnabled="{Binding CustUpdateFile.IsEditEnabled, Mode=OneWay}"
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="4" 
                                           Content="Clear" 
                                           
                                           Tag="CustUpdate"
                                           Click="ClearOtaFile_Click" 
                                           IsEnabled="{Binding CustUpdateFile.HasFile, Mode=OneWay}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8" IsVisible="{Binding IsUsbUpdateSelected}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                           Text="Preload PTABLE" 
                                           FontWeight="SemiBold" 
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1" 
                                            x:Name="PreloadPtablePathText"
                                            Text="{Binding PreloadPtableFile.FileName, Mode=OneWay}" 
                                            IsReadOnly="True"
                                            Watermark="No file selected"
                                            Margin="8,0"/>

                                        <Button Grid.Column="2" 
                                           Content="Browse" 
                                           
                                           Tag="PreloadPtable"
                                           Click="BrowseOtaFile_Click" 
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="3" 
                                           Content="Edit" 
                                           
                                           Tag="PreloadPtable"
                                           Click="EditOtaFile_Click" 
                                           IsEnabled="False"
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="4" 
                                           Content="Clear" 
                                           
                                           Tag="PreloadPtable"
                                           Click="ClearOtaFile_Click" 
                                           IsEnabled="{Binding PreloadPtableFile.HasFile, Mode=OneWay}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                           Text="Preload UPDATE" 
                                           FontWeight="SemiBold" 
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1" 
                                            x:Name="PreloadUpdatePathText"
                                            Text="{Binding PreloadUpdateFile.FileName, Mode=OneWay}" 
                                            IsReadOnly="True"
                                            Watermark="No file selected"
                                            Margin="8,0"/>

                                        <Button Grid.Column="2" 
                                           Content="Browse" 
                                           
                                           Tag="PreloadUpdate"
                                           Click="BrowseOtaFile_Click" 
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="3" 
                                           Content="Edit" 
                                           
                                           Tag="PreloadUpdate"
                                           Click="EditOtaFile_Click" 
                                           IsEnabled="{Binding PreloadUpdateFile.IsEditEnabled, Mode=OneWay}"
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="4" 
                                           Content="Clear" 
                                           
                                           Tag="PreloadUpdate"
                                           Click="ClearOtaFile_Click" 
                                           IsEnabled="{Binding PreloadUpdateFile.HasFile, Mode=OneWay}"/>
                                        </Grid>

                                    <Border Background="{DynamicResource SystemRegionBrush}" 
                                        CornerRadius="8" 
                                        Padding="16" 
                                        Margin="0,16,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock Text="Full OTA Status"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Margin="0,0,0,4"/>
                                                <TextBlock x:Name="FullOtaStatusText" 
                                                   Text="{Binding FullOtaStatusMessage, Mode=OneWay}" 
                                                   FontSize="12" 
                                                   Opacity="0.7"/>
                                            </StackPanel>

                                            <Border Grid.Row="1" Grid.ColumnSpan="2" IsVisible="{Binding ShowFullOtaWarning, Mode=OneWay}" Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16"><StackPanel><TextBlock Text="Incomplete OTA Warning" FontWeight="SemiBold" Foreground="Black"/><TextBlock Text="{Binding FullOtaWarningMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="Black"/></StackPanel></Border>

                                            <Button Grid.Row="2" Grid.Column="1"
                                               x:Name="StartFullOtaButton"
                                               IsEnabled="{Binding CanStartFullOta, Mode=OneWay}"
                                               Click="StartFullOtaButton_Click"
                                               Content="Start Flash"
                                               Width="140"
                                               Height="40">
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Enable Downgrade"
                                         
                                         Margin="0,0,0,16"
                                         IsExpanded="False">
                                <StackPanel>
                                    <Grid Margin="0,8,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Enable Downgrade"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Margin="0,0,0,4"/>
                                            <TextBlock Text="With this option you can enable the ability to flash older firmwares from USB Update mode (requires unlocked fastboot)"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.7"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                               Content="Enable"
                                               
                                               Width="120"
                                               Height="40"
                                               Margin="16,0,0,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Tag="enable-downgrade"
                                               Click="OperationButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Reboot to USB Update"
                                         
                                         Margin="0,0,0,16"
                                         IsExpanded="False">
                                <StackPanel Margin="0,8,0,8">
                                    <TextBlock Text="Reboot to USB Update"
                                           FontWeight="SemiBold"
                                           FontSize="16"
                                           Margin="0,0,0,4"/>
                                    <TextBlock Text="Reboot to USB Update mode from fastboot mode"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Opacity="0.7"/>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" 
                                                 Watermark="Base UPDATE.APP"
                                                 Text="{Binding UsbUpdateFile.FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="True"
                                                 Margin="0,0,8,0"/>

                                        <Button Grid.Column="1"
                                               Content="Browse"
                                               
                                               Tag="UsbUpdate"
                                               Click="BrowseOtaFile_Click"
                                               Margin="0,0,4,0"/>

                                        <Button Grid.Column="2" 
                                               Content="Clear" 
                                               
                                               Tag="UsbUpdate"
                                               Click="ClearOtaFile_Click" 
                                               IsEnabled="{Binding UsbUpdateFile.HasFile, Mode=OneWay}"/>
                                    </Grid>

                                    <Button Content="Reboot"
                                           
                                           Width="140"
                                           Height="40"
                                           HorizontalAlignment="Right"
                                           Margin="0,16,0,0"
                                           Tag="reboot-usb-update"
                                           Click="OperationButton_Click"/>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Fastboot Flasher"
                                         
                                         Margin="0,0,0,16"
                                         IsExpanded="False">
                                <StackPanel>
                                    <TextBlock Text="Dump partitions from device or flash images (requires unlocked fastboot)"
                                       FontSize="12"
                                       Opacity="0.7"
                                       Margin="0,8,0,16"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Dump Partitions"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                            <TextBlock Text="Extract partitions from connected device (810, 820, 985 not supported)"
                                               FontSize="12"
                                               Opacity="0.7"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                           Content="Dump"
                                           
                                           Width="140"
                                           Height="40"
                                           Click="DumpPartitions_Click"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Flash Partitions"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                            <TextBlock Text="Flash partition images from XML"
                                               FontSize="12"
                                               Opacity="0.7"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                           Content="Flash"
                                           Width="140"
                                           Height="40"
                                           Click="FlashFromXml_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                        </StackPanel>

                        <StackPanel x:Name="SecurityPage" Margin="40,32,40,32" IsVisible="False">
                            <TextBlock Text="Security Tools" 
                                  FontSize="28" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,8"/>

                            <TextBlock Text="Bypass security locks and restrictions"
                                  FontSize="14"
                                  Opacity="0.7"
                                  Margin="0,0,0,32"/>

                            <Expander Header="Security Bypass"
                                        
                                        Margin="0,0,0,4"
                                        IsExpanded="True">
                                <StackPanel>
                                    <Grid Margin="0,8,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="FRP Lock Removal"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Margin="0,0,0,4"/>
                                            <TextBlock Text="Remove Factory Reset Protection lock  (requires unlocked fastboot)"
                                                   FontSize="12"
                                                   Opacity="0.7"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                               Content="Remove FRP"
                                               Width="100"
                                               Height="40"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Tag="frp-remove"
                                               Click="OperationButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Unlocking"
                                        
                                        Margin="0,16,0,4"
                                        IsExpanded="True"
                                        x:Name="UnlockBootloaderPanel"
                                        IsVisible="False">
                                <StackPanel>
                                    <Grid Margin="0,8,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Unlock Bootloader"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Margin="0,0,0,4"/>
                                            <TextBlock Text="Unlock the device's bootloader (requires unlocked fastboot)"
                                                   FontSize="12"
                                                   Opacity="0.7"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                               Content="Unlock"
                                               Width="100"
                                               Height="40"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Tag="unlock-bootloader"
                                               Click="OperationButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <StackPanel x:Name="OEMInfoPage" Margin="40,32,40,32" IsVisible="False">
                            <TextBlock Text="OEMInfo Tools" 
                                  FontSize="28" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,8"/>

                            <TextBlock Text="Convert your OEMInfo files"
                                  FontSize="14"
                                  Opacity="0.7"
                                  Margin="0,0,0,32"/>

                            <Expander Header="OEMInfo Converter"
                                        
                                        Margin="0,0,0,4"
                                        IsExpanded="True">
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Convert OEMInfo"
                                               FontWeight="SemiBold"
                                               FontSize="16"
                                               Margin="0,0,0,4"/>

                                        <TextBlock Text="Convert your OEMInfo to your desired version (requires unlocked fastboot)"
                                               FontSize="12"
                                               Opacity="0.7"
                                               Margin="0,0,0,16"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <ToggleSwitch x:Name="TogLivePull" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="devSwtxt" Text="Get OEMInfo from device" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" x:Name="FileSelectionPanel">
                                            <TextBlock Text="OEMInfo File:" Width="120" VerticalAlignment="Center"/>
                                            <TextBox Width="200" x:Name="TxtOemInfoFile" Watermark="Select OEMInfo file" Margin="0,0,8,0"/>
                                            <Button Content="Browse"  Click="BrowseOemInfoFile_Click"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Device Model:" Width="120" VerticalAlignment="Center"/>
                                            <TextBox Width="200" x:Name="TxtDeviceModel" Watermark="e.g. VOG-AL00"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Vendor/Country:" Width="120" VerticalAlignment="Center"/>
                                            <TextBox Width="200" x:Name="TxtVendor" Watermark="e.g. all/cn"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                           Content="Convert"
                                           Width="100"
                                           Height="40"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           x:Name="BtnConvertOem"
                                           Click="BtnConvertOem_Click"/>
                               </Grid>
                            </Expander>
                        </StackPanel>

                        <StackPanel x:Name="NVMePage" Margin="40,32,40,32" IsVisible="False">
                            <TextBlock Text="NVMe Tools" 
                                  FontSize="28" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,8"/>

                            <TextBlock Text="Manage values stored in the device's NVMe"
                                  FontSize="14"
                                  Opacity="0.7"
                                  Margin="0,0,0,32"/>

                            <Expander Header="Serial Number Management"
                                        
                                        Margin="0,0,0,4"
                                        IsExpanded="True">
                                <StackPanel>
                                    <Grid Margin="0,8,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Current Serial Number"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Margin="0,0,0,4"/>
                                            <TextBlock Text="Read the current device serial number"
                                                   FontSize="12"
                                                   Opacity="0.7"
                                                   Margin="0,0,0,8"/>
                                            <TextBlock Text="---" 
                                                   FontFamily="monospace" 
                                                   FontSize="12" 
                                                   x:Name="CurrentSerialDisplay"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                               Content="Read SN"
                                               
                                               Width="100"
                                               Height="40"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Tag="read-sn"
                                               Click="OperationButton_Click"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Write New Serial Number"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Margin="0,0,0,4"/>
                                            <TextBlock Text="Enter new serial number (requires unlocked fastboot)"
                                                   FontSize="12"
                                                   Opacity="0.7"
                                                   Margin="0,0,0,8"/>
                                            <TextBox x:Name="NewSerialInput" 
                                                    Watermark="Enter new serial number" 
                                                    Width="300"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                               Content="Write SN"
                                               Width="100"
                                               Height="40"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Tag="write-sn"
                                               Click="OperationButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <StackPanel x:Name="AboutPage" Margin="40,32,40,32" IsVisible="False">
                            <TextBlock Text="About Kirin-Tool" 
                                  FontSize="28" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,8"/>

                            <TextBlock Text="Version information and credits"
                                  FontSize="14"
                                  Opacity="0.7"
                                  Margin="0,0,0,32"/>

                            <Expander Header="About and Credits"
                                        
                                        Margin="0,0,0,4"
                                        IsExpanded="True">
                                <StackPanel>
                                    <TextBlock Text="Kirin-Tool v2.4.2" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="© Kethily Daniel and NDXCode" 
                                          FontSize="14" 
                                          Opacity="0.7"
                                          Margin="0,0,0,16"/>
                                    <TextBlock Text="Credits:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                    <TextBlock Text="• TASZK Security Labs SL - Bootrom exploit" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Text="• kasnria001 - Decrypted XLOADERs and lots of help in general" FontSize="12" Margin="0,0,0,16"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Kirin-Tool Guide"  Click="HelpButton_Click" Margin="0,0,8,0"/>
                                        <Button Content="Telegram Support"  Click="TelegramButton_Click" Margin="0,0,8,0"/>
                                        <Button Content="GitHub"  Click="GithubButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Grid>

        <Grid x:Name="GlobalInteractionOverlay" Grid.RowSpan="2" IsVisible="False"
              Background="#91000000"
              VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="600"
                    Padding="64,40">
                <StackPanel>
                    <TextBlock Text="Action needed!"
                               LineHeight="28"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,0,0,24"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="InteractionMessageTextBlock"
                               FontSize="16"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,32"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Done!"
                                Width="140"
                                Height="40"
                                Margin="0,0,16,0"
                                Click="GlobalInteractionDone_Click"/>
                        <Button Content="Cancel"
                                Width="140"
                                Height="40"
                                Click="GlobalInteractionCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
