    in the LICENSE file and at www.mariadb.com/bsl11.

    Change Date: Four years from the date each version of the Licensed Work
    is first publicly distributed.

    On the Change Date, in accordance with the Business Source License,
    use of this software will be governed by the GNU General Public License v3.0
    or later (GPL-3.0-or-later).

    Contact Information: https://kirintool.cfd
-->

<Window x:Class="Kirin_Tool.MainWindow"
                 xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:Kirin_Tool.UI"
                 Title="Kirin Tool for Linux" Height="700" Width="1000"
                 WindowStartupLocation="CenterScreen" Background="#FAFAFA"
                 SystemDecorations="BorderOnly" MinWidth="1000" MinHeight="700">

    <Window.Styles>
        <Style Selector="Border.notice">
            <Setter Property="Background" Value="#FFF3CD"/>
            <Setter Property="BorderBrush" Value="#FFE69C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:WindowCaption Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F4F4F4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="16">
                            <TextBlock Text="CPU Model" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ComboBox x:Name="CpuComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="Select CPU Model..." IsEnabled="False"/>
                                <ComboBoxItem Content="Kirin 65x_a (hisi65x_a)"/>
                                <ComboBoxItem Content="Kirin 65x_b (hisi65x_b)"/>
                                <ComboBoxItem Content="Kirin 620 (hisi620)"/>
                                <ComboBoxItem Content="Kirin 620c (hisi620c)"/>
                                <ComboBoxItem Content="Kirin 925 (hisi925)"/>
                                <ComboBoxItem Content="Kirin 935 (hisi935)"/>
                                <ComboBoxItem Content="Kirin 950 (hisi950)"/>
                                <ComboBoxItem Content="Kirin 955 (hisi955)"/>
                                <ComboBoxItem Content="Kirin 960 (hisi960)"/>
                                <ComboBoxItem Content="Kirin 970 (hisi970)"/>
                                <ComboBoxItem Content="Kirin 980 (hisi980)"/>
                                <ComboBoxItem Content="Kirin 985 (hisi985)"/>
                                <ComboBoxItem Content="Kirin 990 5G (hisi990)"/>
                                <ComboBoxItem Content="Kirin 9000 (hisi9000) — Experimental"/>
                                <ComboBoxItem Content="Kirin 710 (hisi710)"/>
                                <ComboBoxItem Content="Kirin 710a (hisi710a)"/>
                                <ComboBoxItem Content="Kirin 810 (hisi810)"/>
                                <ComboBoxItem Content="Kirin 820 (hisi820)"/>
                                <ComboBoxItem Content="Kirin K3v2 (hisik3v2)"/>
                            </ComboBox>
                        </StackPanel>

                        <ListBox x:Name="NavigationListBox"
                              Grid.Row="1"
                              Width="320"
                              Margin="0,24,0,0">

                                <ListBoxItem x:Name="WelcomeItem" Tag="Welcome" Classes="navigation" AutomationProperties.Name="Welcome">
                                    <Grid ColumnDefinitions="24,*">
                                        <Path Data="M3,10 L12,3 L21,10 M5,9 L5,21 L10,21 L10,14 L14,14 L14,21 L19,21 L19,9" Stroke="#404040" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Welcome" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem x:Name="DeviceInfoItem" Tag="DeviceInfo" Classes="navigation" AutomationProperties.Name="Device Information">
                                    <Grid ColumnDefinitions="24,*">
                                        <Path Data="M12,2 A10,10 0 1 1 11.99,2 M12,10 L12,17 M12,6 L12,7" Stroke="#404040" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Device Information" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem x:Name="VcomItem" Tag="Vcom" Classes="navigation" AutomationProperties.Name="VCOM Operations">
                                    <Grid ColumnDefinitions="24,*">
                                        <Path Data="M9,2 L9,7 M15,2 L15,7 M7,7 L17,7 L17,13 L14,16 L14,19 L10,19 L10,16 L7,13 Z M12,19 L12,23" Stroke="#404040" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="VCOM Operations" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem x:Name="FlashItem" Tag="Flash" Classes="navigation" AutomationProperties.Name="Flash Operations">
                                    <Grid ColumnDefinitions="24,*">
                                        <Path Data="M4,8 L20,8 Q22,8 22,10 L22,14 Q22,16 20,16 L4,16 Q2,16 2,14 L2,10 Q2,8 4,8 Z M16,12 L17,12 M19,12 L20,12" Stroke="#404040" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Flash Operations" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem x:Name="SecurityItem" Tag="Security" Classes="navigation" AutomationProperties.Name="Security Tools">
                                    <Grid ColumnDefinitions="24,*">
                                        <Path Data="M12,2 L21,6 L20,14 Q18,20 12,22 Q6,20 4,14 L3,6 Z" Stroke="#404040" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Security Tools" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem x:Name="OEMInfoItem" Tag="OEMInfo" Classes="navigation" AutomationProperties.Name="OEMInfo Tools">
                                    <Grid ColumnDefinitions="24,*">
                                        <Path Data="M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 Z M12,8 L12,16 M8,12 L16,12" Stroke="#404040" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="OEMInfo Tools" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem x:Name="NVMeItem" Tag="NVMe" Classes="navigation" AutomationProperties.Name="NVMe Tools">
                                    <Grid ColumnDefinitions="24,*">
                                        <Path Data="M3,3 L13,3 L22,12 L12,22 L3,13 Z M7,7 A1,1 0 1 1 6.99,7" Stroke="#404040" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="NVMe Tools" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem x:Name="ExtractorItem" Tag="Extractor" Classes="navigation" AutomationProperties.Name="Extractor Tools">
                                    <Grid ColumnDefinitions="24,*">
                                        <Path Data="M3,8 L3,20 L21,20 L21,8 M12,2 L12,15 M7,10 L12,15 L17,10" Stroke="#404040" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Extractor Tools" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem x:Name="AboutItem" Tag="About" Classes="navigation" AutomationProperties.Name="About">
                                    <Grid ColumnDefinitions="24,*">
                                        <Path Data="M12,2 A10,10 0 1 1 11.99,2 M12,10 L12,17 M12,6 L12,7" Stroke="#404040" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="About" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </Grid>
                                </ListBoxItem>
                        </ListBox>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1" 
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">

                    <Grid x:Name="ContentContainer">

                        <StackPanel x:Name="WelcomePage" Margin="40,32,40,32">
                            <TextBlock Text="Welcome to Kirin-Tool"
                                  FontSize="32" 
                                  FontWeight="Light"
                                  Margin="0,0,0,16"/>

                            <TextBlock Text="The best free tool to deal with HiSilicon Kirin devices"
                                  FontSize="16"
                                  Opacity="0.7"
                                  Margin="0,0,0,32"/>

                            <Border x:Name="UdevNotice" Classes="notice" IsVisible="False">
                                <Grid ColumnDefinitions="20,*">
                                    <Path Data="M12,2 A10,10 0 1 1 11.99,2 M12,6 L12,13 M12,16 L12,17" Stroke="#A56500" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="8">
                                        <TextBlock Text="Apply udev rules" FontWeight="SemiBold" Foreground="Black"/>
                                        <TextBlock x:Name="UdevNoticeDescription" TextWrapping="Wrap" Foreground="Black"/>
                                        <TextBox x:Name="UdevCommands" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="monospace" FontSize="12"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="CopyUdevCommandsButton" Content="Copy commands" Click="CopyUdevCommands_Click"/>
                                            <Button Content="Check again" Click="CheckUdevRules_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="UdevCopyStatus" TextWrapping="Wrap" FontSize="12" Foreground="Black"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="Kirin9000Notice" Classes="notice" IsVisible="False">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Kirin 9000 — Experimental" FontWeight="SemiBold"/>
                                    <TextBlock Text="Read-only information and experimental reboot to USB Update are available. Other device operations are unsupported. No Kirin 9000 VCOM loader is included." TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <ui:WindowsExpander Header="Quick Start Guide" IsExpanded="True" HorizontalAlignment="Stretch" Margin="0,0,0,32">

                                <StackPanel Spacing="0">
                                    <Border Background="White" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4" Padding="14,12" MinHeight="56">
                                        <Grid ColumnDefinitions="210,*">
                                            <TextBlock Text="Step 1: Select CPU Model" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Choose your device’s CPU model from the dropdown above" TextWrapping="Wrap" FontSize="12" Foreground="#666666" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="White" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4" Padding="14,12" MinHeight="56">
                                        <Grid ColumnDefinitions="210,*">
                                            <TextBlock Text="Step 2: Connect Device" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Connect your device in VCOM (USB COM 1.0) mode. Make sure that the drivers are installed." TextWrapping="Wrap" FontSize="12" Foreground="#666666" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="White" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4" Padding="14,12" MinHeight="56">
                                        <Grid ColumnDefinitions="210,*">
                                            <TextBlock Text="Step 3: Choose Operation" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Navigate to the appropriate section for your desired operation" TextWrapping="Wrap" FontSize="12" Foreground="#666666" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ui:WindowsExpander>

                            <Border Classes="notice"><Grid ColumnDefinitions="20,*"><Path Data="M12,2 A10,10 0 1 1 11.99,2 M12,6 L12,13 M12,16 L12,17" Stroke="#A56500" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Top" Margin="0,4,0,0"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Important Notice" FontWeight="SemiBold" Foreground="Black"/><TextBlock Text="We are not responsible for any kind of damage you do with this tool. Use it at your own risk." TextWrapping="Wrap" Foreground="Black"/></StackPanel></Grid></Border>

                            <Border Classes="notice"><Grid ColumnDefinitions="20,*"><Path Data="M12,2 A10,10 0 1 1 11.99,2 M12,6 L12,13 M12,16 L12,17" Stroke="#A56500" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Top" Margin="0,4,0,0"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Beware!" FontWeight="SemiBold" Foreground="Black"/><TextBlock Text="Kirin Tool for Linux is free software. If you have paid for this tool, you have been scammed - please ask for a refund immediately!" TextWrapping="Wrap" Foreground="Black"/></StackPanel></Grid></Border>

                        </StackPanel>

                        <StackPanel x:Name="DeviceInfoPage" Margin="40,32,40,32" IsVisible="False">
                            <TextBlock Text="Device Information" 
                                   FontSize="28" 
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                            <TextBlock Text="Connected Device Details"
                                   FontSize="14"
                                   Opacity="0.7"
                                   Margin="0,0,0,32"/>

                            <ui:WindowsExpander x:Name="DeviceInfoExpander"
                                         Header="Information"
                                         
                                         Margin="0,0,0,4"
                                         IsExpanded="False">
                                <StackPanel>
                                    <ui:WindowsCard Header="FB Lock">
                                        <TextBlock x:Name="InfoFbLock"
                                                 Text="Not Read"
                                                 FontWeight="SemiBold"
                                                 Foreground="#666666" TextWrapping="Wrap" />
                                    </ui:WindowsCard>

                                    <ui:WindowsCard Header="User Lock">
                                        <TextBlock x:Name="InfoUserLock"
                                                 Text="Not Read"
                                                 FontWeight="SemiBold"
                                                 Foreground="#666666" TextWrapping="Wrap" />
                                    </ui:WindowsCard>

                                    <ui:WindowsCard Header="Device Model">
                                        <TextBlock x:Name="InfoDeviceModel"
                                                 Text="Not Read"
                                                 FontWeight="SemiBold"
                                                 Foreground="#666666" TextWrapping="Wrap" />
                                    </ui:WindowsCard>
                                    
                                    <ui:WindowsCard Header="Vendor / Country">
                                        <TextBlock x:Name="InfoVendorCountry"
                                                 Text="Not Read"
                                                 FontWeight="SemiBold"
                                                 Foreground="#666666" TextWrapping="Wrap" />
                                    </ui:WindowsCard>

                                    <ui:WindowsCard Header="Build Number">
                                        <TextBlock x:Name="InfoBuildNumber"
                                                 Text="Not Read"
                                                 FontWeight="SemiBold"
                                                 Foreground="#666666" TextWrapping="Wrap" />
                                    </ui:WindowsCard>

                                    <ui:WindowsCard Header="Base Version">
                                        <TextBlock x:Name="InfoBaseVersion"
                                                 Text="Not Read"
                                                 FontWeight="SemiBold"
                                                 Foreground="#666666" TextWrapping="Wrap" />
                                    </ui:WindowsCard>

                                    <ui:WindowsCard Header="Custom Version">
                                        <TextBlock x:Name="InfoCustomVersion"
                                                 Text="Not Read"
                                                 FontWeight="SemiBold"
                                                 Foreground="#666666" TextWrapping="Wrap" />
                                    </ui:WindowsCard>

                                    <ui:WindowsCard Header="Preload Version">
                                        <TextBlock x:Name="InfoPreloadVersion"
                                                 Text="Not Read"
                                                 FontWeight="SemiBold"
                                                 Foreground="#666666" TextWrapping="Wrap" />
                                    </ui:WindowsCard>
                                </StackPanel>
                            </ui:WindowsExpander>

                            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                <Button Classes="accent" Content="Read Info"
                                           
                                           Width="140"
                                           Height="40"
                                           Margin="0,0,16,0"
                                           Click="ReadDeviceInfo_Click"/>
                                    <Button Content="Read SN / PSID" Click="ReadPsid_Click" Width="140" Height="40" Margin="0,0,16,0"/>
                                
                                <Button Content="Reboot"
                                           
                                           Width="140"
                                           Height="40"
                                           Click="RebootDevice_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="VcomPage" Margin="40,32,40,32" IsVisible="False">
                            <TextBlock Text="VCOM Operations" 
                                  FontSize="28" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,8"/>

                            <TextBlock Text="Boot into an unlocked fastboot state from VCOM (USB COM 1.0) mode"
                                  FontSize="14"
                                  Opacity="0.7"
                                  Margin="0,0,0,32"/>

                            <ui:WindowsExpander Header="Device Operations"
                                        
                                        Margin="0,0,0,4"
                                        IsExpanded="True">
                                <StackPanel>
                                    <Grid Margin="0,8,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Unlock Fastboot"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Margin="0,0,0,4"/>
                                            <TextBlock Text="Put device into unlocked fastboot state"
                                                   FontSize="12"
                                                   Opacity="0.7"/>
                                            <ToggleSwitch x:Name="UseFastFlashLoaderSwitch"
                                                   Content="Use FastFlash loader"
                                                   IsVisible="False"
                                                   Margin="0,16,0,0" />
                                        </StackPanel>

                                        <Button Classes="accent" Grid.Column="1"
                                               Content="Unlock"
                                               Width="100"
                                               Height="40"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Tag="unlock-fastboot"
                                               Click="OperationButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </ui:WindowsExpander>

                            <ui:WindowsExpander Header="Software Testpoint"
                                         
                                         Margin="0,0,0,16"
                                         IsExpanded="False">
                                <StackPanel>
                                    <TextBlock Text="Put your device into VCOM mode without disassembling it"
                                           FontSize="12"
                                           Opacity="0.7"
                                           Margin="0,0,0,16"/>

                                    <Border Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16"><StackPanel><TextBlock Text="Important notice" FontWeight="SemiBold" Foreground="Black"/><TextBlock Text="This feature only works on softwares before the 2021 February security patch (EMUI 10 and older), if you are running a newer system, please downgrade to use this feature. &#10;&#10;For the UPDATE file use a Base UPDATE.APP from the exact or newer firmware your device is currently running." TextWrapping="Wrap" Foreground="Black"/></StackPanel></Border>

                                    <Grid Margin="0,8,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" 
                                                 Watermark="Base UPDATE.APP"
                                                 Text="{Binding SwTpUpdateFile.FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="True"
                                                 Margin="0,0,8,0"/>
                                        <Button Grid.Column="1"
                                               Content="Browse"
                                               
                                               Tag="SwTpUpdate"
                                               Click="BrowseOtaFile_Click"
                                               Margin="0,0,4,0"/>
                                        <Button Grid.Column="2" 
                                               Content="Clear" 
                                               
                                               Tag="SwTpUpdate"
                                               Click="ClearOtaFile_Click" 
                                               IsEnabled="{Binding SwTpUpdateFile.HasFile, Mode=OneWay}"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Classes="accent" Content="Enter"
                                               Width="100"
                                               Height="40"
                                               Margin="0,0,8,0"
                                               Tag="sw-testpoint-enter"
                                               Click="OperationButton_Click"/>
                                        <Button Content="Exit"
                                               Width="100"
                                               Height="40"
                                               Tag="sw-testpoint-exit"
                                               Click="OperationButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:WindowsExpander>
                        </StackPanel>

                        <StackPanel x:Name="FlashPage" Margin="40,32,40,32" IsVisible="False">
                            <TextBlock Text="Flash Operations" 
                                  FontSize="28" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,8"/>

                            <TextBlock Text="Flash firmware and system images"
                                  FontSize="14"
                                  Opacity="0.7"
                                  Margin="0,0,0,32"/>

                            <ui:WindowsExpander Header="Full OTA Flash"
                                         
                                         Margin="0,0,0,16"
                                         IsExpanded="True">
                                <StackPanel>
                                    <TextBlock Text="Do a complete flash of your device"
                                       FontSize="12"
                                       Opacity="0.7"
                                       Margin="0,0,0,16"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <RadioButton Content="Fastboot Mode" 
                                                   IsChecked="{Binding IsFastbootUpdateSelected, Mode=TwoWay}"
                                                   Margin="0,0,24,0"/>
                                        <RadioButton Content="USB Update Mode" 
                                                   IsChecked="{Binding IsUsbUpdateSelected, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                            Text="Base PTABLE" 
                                            FontWeight="SemiBold" 
                                            FontSize="12"
                                            VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1" 
                                            x:Name="BasePtablePathText"
                                            Text="{Binding BasePtableFile.FileName, Mode=OneWay}" 
                                            IsReadOnly="True"
                                            Watermark="No file selected"
                                            Margin="8,0"/>

                                        <Button Grid.Column="2" 
                                            Content="Browse" 
                                            
                                            Tag="BasePtable"
                                            Click="BrowseOtaFile_Click" 
                                            Margin="0,0,4,0"/>

                                        <Button Grid.Column="3" 
                                            Content="Edit" 
                                            
                                            Tag="BasePtable"
                                            Click="EditOtaFile_Click" 
                                            IsEnabled="{Binding BasePtableFile.IsEditEnabled, Mode=OneWay}"
                                            Margin="0,0,4,0"/>

                                        <Button Grid.Column="4" 
                                            Content="Clear" 
                                            
                                            Tag="BasePtable"
                                            Click="ClearOtaFile_Click" 
                                            IsEnabled="{Binding BasePtableFile.HasFile, Mode=OneWay}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                           Text="Base UPDATE" 
                                           FontWeight="SemiBold" 
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1" 
                                            x:Name="BaseUpdatePathText"
                                            Text="{Binding BaseUpdateFile.FileName, Mode=OneWay}" 
                                            IsReadOnly="True"
                                            Watermark="No file selected"
                                            Margin="8,0"/>

                                        <Button Grid.Column="2" 
                                           Content="Browse" 
                                           
                                           Tag="BaseUpdate"
                                           Click="BrowseOtaFile_Click" 
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="3" 
                                           Content="Edit" 
                                           
                                           Tag="BaseUpdate"
                                           Click="EditOtaFile_Click" 
                                           IsEnabled="{Binding BaseUpdateFile.IsEditEnabled, Mode=OneWay}"
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="4" 
                                           Content="Clear" 
                                           
                                           Tag="BaseUpdate"
                                           Click="ClearOtaFile_Click" 
                                           IsEnabled="{Binding BaseUpdateFile.HasFile, Mode=OneWay}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8" IsVisible="{Binding IsUsbUpdateSelected}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                           Text="Cust PTABLE" 
                                           FontWeight="SemiBold" 
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1" 
                                            x:Name="CustPtablePathText"
                                            Text="{Binding CustPtableFile.FileName, Mode=OneWay}" 
                                            IsReadOnly="True"
                                            Watermark="No file selected"
                                            Margin="8,0"/>

                                        <Button Grid.Column="2" 
                                           Content="Browse" 
                                           
                                           Tag="CustPtable"
                                           Click="BrowseOtaFile_Click" 
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="3" 
                                           Content="Edit" 
                                           
                                           Tag="CustPtable"
                                           Click="EditOtaFile_Click" 
                                           IsEnabled="False"
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="4" 
                                           Content="Clear" 
                                           
                                           Tag="CustPtable"
                                           Click="ClearOtaFile_Click" 
                                           IsEnabled="{Binding CustPtableFile.HasFile, Mode=OneWay}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                           Text="Cust UPDATE" 
                                           FontWeight="SemiBold" 
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1" 
                                            x:Name="CustUpdatePathText"
                                            Text="{Binding CustUpdateFile.FileName, Mode=OneWay}" 
                                            IsReadOnly="True"
                                            Watermark="No file selected"
                                            Margin="8,0"/>

                                        <Button Grid.Column="2" 
                                           Content="Browse" 
                                           
                                           Tag="CustUpdate"
                                           Click="BrowseOtaFile_Click" 
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="3" 
                                           Content="Edit" 
                                           
                                           Tag="CustUpdate"
                                           Click="EditOtaFile_Click" 
                                           IsEnabled="{Binding CustUpdateFile.IsEditEnabled, Mode=OneWay}"
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="4" 
                                           Content="Clear" 
                                           
                                           Tag="CustUpdate"
                                           Click="ClearOtaFile_Click" 
                                           IsEnabled="{Binding CustUpdateFile.HasFile, Mode=OneWay}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8" IsVisible="{Binding IsUsbUpdateSelected}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                           Text="Preload PTABLE" 
                                           FontWeight="SemiBold" 
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1" 
                                            x:Name="PreloadPtablePathText"
                                            Text="{Binding PreloadPtableFile.FileName, Mode=OneWay}" 
                                            IsReadOnly="True"
                                            Watermark="No file selected"
                                            Margin="8,0"/>

                                        <Button Grid.Column="2" 
                                           Content="Browse" 
                                           
                                           Tag="PreloadPtable"
                                           Click="BrowseOtaFile_Click" 
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="3" 
                                           Content="Edit" 
                                           
                                           Tag="PreloadPtable"
                                           Click="EditOtaFile_Click" 
                                           IsEnabled="False"
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="4" 
                                           Content="Clear" 
                                           
                                           Tag="PreloadPtable"
                                           Click="ClearOtaFile_Click" 
                                           IsEnabled="{Binding PreloadPtableFile.HasFile, Mode=OneWay}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                           Text="Preload UPDATE" 
                                           FontWeight="SemiBold" 
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1" 
                                            x:Name="PreloadUpdatePathText"
                                            Text="{Binding PreloadUpdateFile.FileName, Mode=OneWay}" 
                                            IsReadOnly="True"
                                            Watermark="No file selected"
                                            Margin="8,0"/>

                                        <Button Grid.Column="2" 
                                           Content="Browse" 
                                           
                                           Tag="PreloadUpdate"
                                           Click="BrowseOtaFile_Click" 
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="3" 
                                           Content="Edit" 
                                           
                                           Tag="PreloadUpdate"
                                           Click="EditOtaFile_Click" 
                                           IsEnabled="{Binding PreloadUpdateFile.IsEditEnabled, Mode=OneWay}"
                                           Margin="0,0,4,0"/>

                                        <Button Grid.Column="4" 
                                           Content="Clear" 
                                           
                                           Tag="PreloadUpdate"
                                           Click="ClearOtaFile_Click" 
                                           IsEnabled="{Binding PreloadUpdateFile.HasFile, Mode=OneWay}"/>
                                        </Grid>

                                    <Border Background="{DynamicResource SystemRegionBrush}" 
                                        CornerRadius="8" 
                                        Padding="16" 
                                        Margin="0,16,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock Text="Full OTA Status"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Margin="0,0,0,4"/>
                                                <TextBlock x:Name="FullOtaStatusText" 
                                                   Text="{Binding FullOtaStatusMessage, Mode=OneWay}" 
                                                   FontSize="12" 
                                                   Opacity="0.7"/>
                                            </StackPanel>

                                            <Border Grid.Row="1" Grid.ColumnSpan="2" IsVisible="{Binding ShowFullOtaWarning, Mode=OneWay}" Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16"><StackPanel><TextBlock Text="Incomplete OTA Warning" FontWeight="SemiBold" Foreground="Black"/><TextBlock Text="{Binding FullOtaWarningMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="Black"/></StackPanel></Border>

                                            <Button Grid.Row="2" Grid.Column="1"
                                               x:Name="StartFullOtaButton"
                                               IsEnabled="{Binding CanStartFullOta, Mode=OneWay}"
                                               Click="StartFullOtaButton_Click"
                                               Content="Start Flash"
                                               Width="140"
                                               Height="40">
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ui:WindowsExpander>

                            <ui:WindowsExpander Header="Enable Downgrade"
                                         
                                         Margin="0,0,0,16"
                                         IsExpanded="False">
                                <StackPanel>
                                    <Grid Margin="0,8,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Enable Downgrade"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Margin="0,0,0,4"/>
                                            <TextBlock Text="With this option you can enable the ability to flash older firmwares from USB Update mode (requires unlocked fastboot)"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.7"/>
                                        </StackPanel>

                                        <Button Classes="accent" Grid.Column="1"
                                               Content="Enable"
                                               
                                               Width="120"
                                               Height="40"
                                               Margin="16,0,0,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Tag="enable-downgrade"
                                               Click="OperationButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </ui:WindowsExpander>

                            <ui:WindowsExpander Header="Reboot to USB Update"
                                         
                                         Margin="0,0,0,16"
                                         IsExpanded="False">
                                <StackPanel Margin="0,8,0,8">
                                    <TextBlock Text="Reboot to USB Update"
                                           FontWeight="SemiBold"
                                           FontSize="16"
                                           Margin="0,0,0,4"/>
                                    <TextBlock Text="Reboot to USB Update mode from fastboot mode"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Opacity="0.7"/>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" 
                                                 Watermark="Base UPDATE.APP"
                                                 Text="{Binding UsbUpdateFile.FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="True"
                                                 Margin="0,0,8,0"/>

                                        <Button Grid.Column="1"
                                               Content="Browse"
                                               
                                               Tag="UsbUpdate"
                                               Click="BrowseOtaFile_Click"
                                               Margin="0,0,4,0"/>

                                        <Button Grid.Column="2" 
                                               Content="Clear" 
                                               
                                               Tag="UsbUpdate"
                                               Click="ClearOtaFile_Click" 
                                               IsEnabled="{Binding UsbUpdateFile.HasFile, Mode=OneWay}"/>
                                    </Grid>

                                    <Button Classes="accent" Content="Reboot"
                                           
                                           Width="140"
                                           Height="40"
                                           HorizontalAlignment="Right"
                                           Margin="0,16,0,0"
                                           Tag="reboot-usb-update"
                                           Click="OperationButton_Click"/>
                                </StackPanel>
                            </ui:WindowsExpander>

                            <ui:WindowsExpander Header="Fastboot Flasher"
                                         
                                         Margin="0,0,0,16"
                                         IsExpanded="False">
                                <StackPanel>
                                    <TextBlock x:Name="Kirin9000RescueHint" IsVisible="False" Text="Experimental Kirin 9000: uses ERECOVERY, ERECOVERY_RAMDISK and ERECOVERY_VENDOR. Rescue destination mapping and successful writes remain unverified." TextWrapping="Wrap" Margin="0,8,0,12"/>

                                    <TextBlock Text="Dump partitions from device or flash images (requires unlocked fastboot)"
                                       FontSize="12"
                                       Opacity="0.7"
                                       Margin="0,8,0,16"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Dump Partitions"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                            <TextBlock Text="Extract partitions from connected device (810, 820, 985 not supported)"
                                               FontSize="12"
                                               Opacity="0.7"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                           Content="Dump"
                                           
                                           Width="140"
                                           Height="40"
                                           Click="DumpPartitions_Click"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Flash Partitions"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                            <TextBlock Text="Flash partition images from XML"
                                               FontSize="12"
                                               Opacity="0.7"/>
                                        </StackPanel>

                                        <Button Classes="accent" Grid.Column="1"
                                           Content="Flash"
                                           Width="140"
                                           Height="40"
                                           Click="FlashFromXml_Click"/>
                                    </Grid>
                                </StackPanel>
                            </ui:WindowsExpander>

                        </StackPanel>

                        <StackPanel x:Name="SecurityPage" Margin="40,32,40,32" IsVisible="False">
                            <TextBlock Text="Security Tools" 
                                  FontSize="28" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,8"/>

                            <TextBlock Text="Bypass security locks and restrictions"
                                  FontSize="14"
                                  Opacity="0.7"
                                  Margin="0,0,0,32"/>

                            <ui:WindowsExpander Header="Security Bypass"
                                        
                                        Margin="0,0,0,4"
                                        IsExpanded="True">
                                <StackPanel>
                                    <Grid Margin="0,8,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="FRP Lock Removal"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Margin="0,0,0,4"/>
                                            <TextBlock Text="Remove Factory Reset Protection lock  (requires unlocked fastboot)"
                                                   FontSize="12"
                                                   Opacity="0.7"/>
                                        </StackPanel>

                                        <Button Classes="caution" Grid.Column="1"
                                               Content="Remove FRP"
                                               Width="100"
                                               Height="40"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Tag="frp-remove"
                                               Click="OperationButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </ui:WindowsExpander>

                            <ui:WindowsExpander Header="Unlocking"
                                        
                                        Margin="0,16,0,4"
                                        IsExpanded="True"
                                        x:Name="UnlockBootloaderPanel"
                                        IsVisible="False">
                                <StackPanel>
                                    <Grid Margin="0,8,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Unlock Bootloader"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Margin="0,0,0,4"/>
                                            <TextBlock Text="Unlock the device's bootloader (requires unlocked fastboot)"
                                                   FontSize="12"
                                                   Opacity="0.7"/>
                                        </StackPanel>

                                        <Button Classes="accent" Grid.Column="1"
                                               Content="Unlock"
                                               Width="100"
                                               Height="40"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Tag="unlock-bootloader"
                                               Click="OperationButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </ui:WindowsExpander>
                        </StackPanel>

                        <StackPanel x:Name="ExtractorPage" Margin="40,32,40,32" IsVisible="False">
                            <TextBlock Text="Extractor Tools" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Extract partitions from a Base, Cust or Preload UPDATE.APP" FontSize="14" Opacity="0.7" Margin="0,0,0,16" TextWrapping="Wrap"/>
                            <ui:WindowsExpander Header="UPDATE.APP Partition Extractor" IsExpanded="True">
                                <StackPanel Spacing="8" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="ExtractorStartButton" Content="Extract Selected" Click="StartExtraction_Click" IsEnabled="False"/>
                                        <Button x:Name="ExtractorCancelButton" Content="Cancel" Click="CancelExtraction_Click" IsEnabled="False"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="ExtractorProgress" Minimum="0" Maximum="100" Value="0"/>
                                    <TextBlock x:Name="ExtractorStatus" Text="Select an UPDATE.APP file to list its partitions." TextWrapping="Wrap" FontSize="12"/>
                                    <StackPanel x:Name="ExtractorInputs" Spacing="8">
                                        <TextBlock Text="UPDATE.APP file" FontWeight="SemiBold"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox x:Name="ExtractorSourcePath" IsReadOnly="True" Watermark="Select an UPDATE.APP file" Margin="0,0,8,0"/>
                                            <Button Grid.Column="1" Content="Browse…" Click="BrowseExtractionSource_Click"/>
                                        </Grid>
                                        <TextBlock Text="Output folder" FontWeight="SemiBold"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox x:Name="ExtractorDestinationPath" IsReadOnly="True" Watermark="Choose where to save the images" Margin="0,0,8,0"/>
                                            <Button Grid.Column="1" Content="Browse…" Click="BrowseExtractionDestination_Click"/>
                                        </Grid>
                                        <TextBlock Text="Saves each selected partition as an .img file. Existing files are kept; use another folder if a filename already exists." FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="ExtractorSelectAllButton" Content="Select All" Click="SelectExtractionAll_Click"/>
                                            <Button x:Name="ExtractorSelectNoneButton" Content="Select None" Click="SelectExtractionNone_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ExtractorSelectionText" Text="0/0 partitions selected"/>
                                        <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                                            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="ExtractorPartitions">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="*,100" Margin="0,4">
                                                                <StackPanel>
                                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Partition.IsSelected, Mode=TwoWay}"/>
                                                                    <TextBlock Text="{Binding FileName}" FontSize="11" Opacity="0.7" Margin="28,0,0,0"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ui:WindowsExpander>
                        </StackPanel>

                        <StackPanel x:Name="OEMInfoPage" Margin="40,32,40,32" IsVisible="False">
                            <TextBlock Text="OEMInfo Tools" 
                                  FontSize="28" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,8"/>

                            <TextBlock Text="Convert your OEMInfo files"
                                  FontSize="14"
                                  Opacity="0.7"
                                  Margin="0,0,0,32"/>

                            <ui:WindowsExpander Header="OEMInfo Converter"
                                        
                                        Margin="0,0,0,4"
                                        IsExpanded="True">
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Convert OEMInfo"
                                               FontWeight="SemiBold"
                                               FontSize="16"
                                               Margin="0,0,0,4"/>

                                        <TextBlock Text="Convert your OEMInfo to your desired version (requires unlocked fastboot)"
                                               FontSize="12"
                                               Opacity="0.7"
                                               Margin="0,0,0,16"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <ToggleSwitch x:Name="TogLivePull" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="devSwtxt" Text="Get OEMInfo from device" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" x:Name="FileSelectionPanel">
                                            <TextBlock Text="OEMInfo File:" Width="120" VerticalAlignment="Center"/>
                                            <TextBox Width="200" x:Name="TxtOemInfoFile" Watermark="Select OEMInfo file" Margin="0,0,8,0"/>
                                            <Button Content="Browse"  Click="BrowseOemInfoFile_Click"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Device Model:" Width="120" VerticalAlignment="Center"/>
                                            <TextBox Width="200" x:Name="TxtDeviceModel" Watermark="e.g. VOG-AL00"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Vendor/Country:" Width="120" VerticalAlignment="Center"/>
                                            <TextBox Width="200" x:Name="TxtVendor" Watermark="e.g. all/cn"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Classes="accent" Grid.Column="1"
                                           Content="Convert"
                                           Width="100"
                                           Height="40"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           x:Name="BtnConvertOem"
                                           Click="BtnConvertOem_Click"/>
                               </Grid>
                            </ui:WindowsExpander>
                        </StackPanel>

                        <StackPanel x:Name="NVMePage" Margin="40,32,40,32" IsVisible="False">
                            <TextBlock Text="NVMe Tools" 
                                  FontSize="28" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,8"/>

                            <TextBlock Text="Manage values stored in the device's NVMe"
                                  FontSize="14"
                                  Opacity="0.7"
                                  Margin="0,0,0,32"/>

                            <ui:WindowsExpander Header="Serial Number Management"
                                        
                                        Margin="0,0,0,4"
                                        IsExpanded="True">
                                <StackPanel>
                                    <Grid Margin="0,8,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Current Serial Number"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Margin="0,0,0,4"/>
                                            <TextBlock Text="Read the current device serial number"
                                                   FontSize="12"
                                                   Opacity="0.7"
                                                   Margin="0,0,0,8"/>
                                            <TextBlock Text="---" 
                                                   FontFamily="monospace" 
                                                   FontSize="12" 
                                                   x:Name="CurrentSerialDisplay"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                               Content="Read NVE SN"
                                               
                                               Width="100"
                                               Height="40"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Tag="read-sn"
                                               Click="OperationButton_Click"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Write New Serial Number"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Margin="0,0,0,4"/>
                                            <TextBlock Text="Enter new serial number (requires unlocked fastboot)"
                                                   FontSize="12"
                                                   Opacity="0.7"
                                                   Margin="0,0,0,8"/>
                                            <TextBox x:Name="NewSerialInput" 
                                                    Watermark="Enter new serial number" 
                                                    Width="300"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>

                                        <Button Classes="accent" Grid.Column="1"
                                               Content="Write SN"
                                               Width="100"
                                               Height="40"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Tag="write-sn"
                                               Click="OperationButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </ui:WindowsExpander>
                        </StackPanel>

                        <StackPanel x:Name="AboutPage" Margin="40,32,40,32" IsVisible="False">
                            <TextBlock Text="About Kirin Tool for Linux"
                                  FontSize="28" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,8"/>

                            <TextBlock Text="Version information and credits"
                                  FontSize="14"
                                  Opacity="0.7"
                                  Margin="0,0,0,32"/>

                            <ui:WindowsExpander Header="About and Credits"
                                        
                                        Margin="0,0,0,4"
                                        IsExpanded="True">
                                <StackPanel>
                                    <TextBlock Text="Kirin Tool for Linux" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="© Kethily Daniel and NDXCode" 
                                          FontSize="14" 
                                          Opacity="0.7"
                                          Margin="0,0,0,16"/>
                                    <TextBlock Text="Credits:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                    <TextBlock Text="• TASZK Security Labs SL - Bootrom exploit" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Text="• kasnria001 - Decrypted XLOADERs and lots of help in general" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Redminote11tech - Single-handed Linux port" FontSize="12" Margin="0,0,0,16"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Kirin-Tool Guide"  Click="HelpButton_Click" Margin="0,0,8,0"/>
                                        <Button Content="Telegram Support"  Click="TelegramButton_Click" Margin="0,0,8,0"/>
                                        <Button Content="GitHub"  Click="GithubButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:WindowsExpander>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Grid>

        <Grid x:Name="GlobalInteractionOverlay" Grid.RowSpan="2" IsVisible="False"
              Background="#91000000"
              VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="600"
                    Padding="64,40">
                <StackPanel>
                    <TextBlock Text="Action needed!"
                               LineHeight="28"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,0,0,24"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="InteractionMessageTextBlock"
                               FontSize="16"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,32"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Classes="accent" Content="Done!"
                                Width="140"
                                Height="40"
                                Margin="0,0,16,0"
                                Click="GlobalInteractionDone_Click"/>
                        <Button Content="Cancel"
                                Width="140"
                                Height="40"
                                Click="GlobalInteractionCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
