pkgname=kirin-tool-linux-unstable
pkgver=2.4.2.usb5
pkgrel=1
pkgdesc='Kirin Tool USB Update transport candidate (hardware validation pending)'
arch=('x86_64')
url='https://github.com/Redminote11tech/kirin-tool-linux'
license=('custom:BSL-1.1' 'MIT')
depends=('glibc' 'gcc-libs' 'fontconfig' 'freetype2' 'libx11' 'libice' 'libsm' 'openssl' 'zlib' 'icu' 'libusb')
options=('!strip' '!debug' '!lto')
install=unstable.install
source=('bundle.tar.gz')
sha256sums=('92065979c2ab60b0619c6d35c7e987b956fd7ccc79b16e98413ae0a16b6bac02')
package() {
    local appdir="$pkgdir/usr/lib/$pkgname"
    install -dm755 "$appdir"
    cp -a "$srcdir/bundle/app/." "$appdir/"
    install -dm755 "$pkgdir/usr/bin"
    ln -s "/usr/lib/$pkgname/Kirin-Tool" "$pkgdir/usr/bin/kirin-tool-unstable"
    ln -s "/usr/lib/$pkgname/UsbUpdateProbe" "$pkgdir/usr/bin/kirin-usb-update-probe"
    ln -s "/usr/lib/$pkgname/VcomOpenProbe" "$pkgdir/usr/bin/kirin-vcom-open-probe"
    install -Dm644 "$srcdir/bundle/61-kirin-userspace.rules" "$pkgdir/usr/lib/udev/rules.d/61-kirin-userspace.rules"
    install -Dm644 "$srcdir/bundle/usb-update-userspace.md" "$pkgdir/usr/share/doc/$pkgname/usb-update-userspace.md"
    install -Dm644 "$srcdir/bundle/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$srcdir/bundle/LICENSE.usb-bridge" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.usb-bridge"
    install -Dm644 "$srcdir/bundle/NOTICE.fastboot-src" "$pkgdir/usr/share/licenses/$pkgname/NOTICE.fastboot-src"
    install -Dm644 "$srcdir/bundle/kirin-tool.png" "$pkgdir/usr/share/pixmaps/kirin-tool-unstable.png"
    install -dm755 "$pkgdir/usr/share/applications"
    cat > "$pkgdir/usr/share/applications/kirin-tool-unstable.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Kirin Tool — USB Update UNSTABLE
Exec=kirin-tool-unstable
Icon=kirin-tool-unstable
Categories=Development;Utility;
Terminal=false
DESKTOP
}
