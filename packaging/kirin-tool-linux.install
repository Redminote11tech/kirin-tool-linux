post_install() {
  cat <<EOF

Kirin Tool for Linux setup notes:
  - udev rules installed to /usr/lib/udev/rules.d/51-kirin-tool-fastboot.rules
  - reload them with:  sudo udevadm control --reload-rules && sudo udevadm trigger
  - make sure your user is in the 'adbusers' group (fastboot) and the 'uucp'
    group (VCOM/DBAdapter serial), e.g.:  sudo usermod -aG adbusers,uucp $USER
    (log out and back in afterwards)
  - a Huawei-capable fastboot is bundled at /usr/lib/kirin-tool-linux/fastboot/fastboot
    and is used automatically; system android-tools fastboot remains as fallback

EOF
}

post_upgrade() {
  post_install
}
