# Maintainer: Redminote11tech
pkgname=kirin-tool-linux
pkgver=2.4.2
pkgrel=10
pkgdesc='Kirin Tool for Linux - stable 3 with partition extraction and native HiSilicon tools'
arch=('x86_64')
# Stable consolidates the candidate; shared probe paths prevent co-installation.
conflicts=('kirin-tool-linux-unstable')
replaces=('kirin-tool-linux-unstable')
url='https://github.com/Redminote11tech/kirin-tool-linux'
license=('custom:BSL-1.1' 'MIT' 'Apache-2.0')
depends=('glibc' 'gcc-libs' 'fontconfig' 'freetype2' 'libx11' 'libice' 'libsm' 'openssl' 'zlib' 'icu' 'libusb')
makedepends=('dotnet-sdk' 'gcc' 'make' 'pkgconf')
options=('!strip' '!debug' '!lto')
install=kirin-tool-linux.install
optdepends=('android-tools: fallback fastboot if the bundled binary is removed')
source=("kirin-tool-linux-$pkgver.tar.gz")
# The release-specific copy pins the committed source archive SHA256.
sha256sums=('SKIP')
build() {
    cd "$srcdir/$pkgname-$pkgver"
    ./packaging/publish.sh "$srcdir/publish-out"
}
check() {
    test -x "$srcdir/publish-out/Kirin-Tool"
    "$srcdir/publish-out/fastboot/fastboot" --version >/dev/null
    test -f "$srcdir/publish-out/libkirin_usb_update.so"
}
package() {
    local appdir="$pkgdir/usr/lib/$pkgname"
    install -dm755 "$appdir"
    cp -a "$srcdir/publish-out/." "$appdir/"
    install -dm755 "$pkgdir/usr/bin"
    ln -s "/usr/lib/$pkgname/Kirin-Tool" "$pkgdir/usr/bin/kirin-tool"
    ln -s "/usr/lib/$pkgname/UsbUpdateProbe" "$pkgdir/usr/bin/kirin-usb-update-probe"
    ln -s "/usr/lib/$pkgname/VcomOpenProbe" "$pkgdir/usr/bin/kirin-vcom-open-probe"
    local root="$srcdir/$pkgname-$pkgver"
    install -Dm644 "$root/packaging/51-kirin-tool-fastboot.rules" "$pkgdir/usr/lib/udev/rules.d/51-kirin-tool-fastboot.rules"
    install -Dm644 "$root/packaging/kirin-tool.png" "$pkgdir/usr/share/pixmaps/kirin-tool.png"
    install -dm755 "$pkgdir/usr/share/licenses/$pkgname" "$pkgdir/usr/share/doc/$pkgname"
    cp "$appdir/licenses/"* "$pkgdir/usr/share/licenses/$pkgname/"
    cp "$appdir/docs/"* "$pkgdir/usr/share/doc/$pkgname/"
    install -Dm644 "$root/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$root/packaging/kirin-tool-appimage.desktop" "$pkgdir/usr/share/applications/kirin-tool.desktop"
    sed -i 's/^Exec=AppRun$/Exec=kirin-tool/' "$pkgdir/usr/share/applications/kirin-tool.desktop"
}
