<Window x:Class="Kirin_Tool.UI.FastbootPartitionSelector"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Select Partitions"
        Width="600"
        Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="White">

    <Border Background="White" 
            CornerRadius="8" 
            BorderBrush="LightGray" 
            BorderThickness="1"
            Margin="0,30,0,30">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" 
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                    <CheckBox x:Name="SelectAllCheckBox"
                             IsChecked="{Binding SelectAllState, Mode=TwoWay}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"
                             MinHeight="24"
                             MinWidth="24"/>
                    <TextBlock Text="Select All"
                              VerticalAlignment="Center"
                              FontWeight="SemiBold"
                              FontSize="14"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                          Text="{Binding StatusText}"
                          VerticalAlignment="Center"
                          FontSize="12"
                          Foreground="Gray"
                          HorizontalAlignment="Right"/>
            </Grid>

            <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Background="White"
                         BorderBrush="LightGray"
                         BorderThickness="1"
                         Padding="12"
                         MaxHeight="300"
                         Margin="0,0,0,12">

                <ItemsControl ItemsSource="{Binding Partitions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,2" 
                                   Padding="12,8"
                                   Background="WhiteSmoke"
                                   BorderBrush="LightGray"
                                   BorderThickness="1"
                                   CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" 
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"
                                             MinHeight="20"
                                             MinWidth="20"/>

                                    <TextBlock Grid.Column="1"
                                              Text="{Binding Name}"
                                              VerticalAlignment="Center"
                                              FontFamily="Consolas"
                                              FontSize="13"/>

                                    <TextBlock Grid.Column="2"
                                              Text="{Binding ImageFileName}"
                                              VerticalAlignment="Center"
                                              FontSize="11"
                                              Foreground="Gray"
                                              Margin="12,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <CheckBox x:Name="SkipSecureCheckBox"
                      Grid.Row="2"
                      Content="Skip secure partitions"
                      IsChecked="{Binding SkipSecurePartitions, Mode=TwoWay}"
                      Margin="0,0,0,12"
                      VerticalAlignment="Center"
                      FontSize="13"/>

            <StackPanel Grid.Row="3" 
                       Orientation="Horizontal" 
                       HorizontalAlignment="Right" 
                       Margin="0,0,0,0">

                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Margin="0,0,10,0"
                        MinWidth="100"
                        Click="CancelButton_Click"/>

                <Button x:Name="ProceedButton"
                        Content="Proceed"
                        IsEnabled="{Binding HasSelectedPartitions}"
                        MinWidth="100"
                        Click="ProceedButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
